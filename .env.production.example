# Production Environment Variables for Render Deployment
# Copy these to Render Dashboard → Environment Variables

# =============================================================================
# REQUIRED - Phải có để app chạy
# =============================================================================

# Application
NODE_ENV=production
PORT=3000
API_VERSION=v1

# Database (Supabase)
# Format: postgresql://postgres.[project-id]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxxx:your-password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# JWT Authentication
# Generate với: openssl rand -hex 32
# Hoặc click "Generate Value" trong Render
JWT_ACCESS_SECRET=your-super-secret-access-key-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# OpenAI API
# Lấy từ: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL_WHISPER=whisper-1
OPENAI_MODEL_GPT=gpt-4o-mini-2024-07-18

# =============================================================================
# OPTIONAL - Cải thiện trải nghiệm
# =============================================================================

# Google Gemini API (Alternative STT provider)
# Lấy từ: https://ai.google.dev/
GEMINI_API_KEY=AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
STT_PROVIDER=whisper  # hoặc 'gemini'

# Storage Configuration
# QUAN TRỌNG: Dùng /tmp trên Render (ephemeral storage)
STORAGE_TYPE=local
STORAGE_PATH=/tmp/uploads

# CORS Origins
# Update với domain frontend của bạn sau khi deploy
CORS_ORIGIN=http://localhost:19006,https://your-frontend-domain.vercel.app

# Logging
# Dùng 'info' trong production (không dùng 'debug' - quá nhiều logs)
LOG_LEVEL=info

# Voice Processing Limits
MAX_AUDIO_FILE_SIZE_MB=10
MAX_AUDIO_DURATION_SEC=60

# =============================================================================
# TELEGRAM BOT (Optional)
# =============================================================================

# Telegram Bot
# Lấy từ: @BotFather
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz
TELEGRAM_WEBHOOK_URL=https://fin-note-api.onrender.com/telegram/webhook

# =============================================================================
# NOTES
# =============================================================================

# 1. KHÔNG commit file này vào Git!
# 2. Render auto-encrypt tất cả environment variables
# 3. Có thể update env vars mà không cần redeploy (chỉ restart)
# 4. Dùng "Generate Value" trong Render cho JWT secrets
# 5. Database URL phải dùng connection pooling từ Supabase (port 6543)
