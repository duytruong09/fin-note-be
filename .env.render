# Critical environment variables for Render deployment
# Add these to Render Dashboard → Environment tab

# ============================================
# MEMORY OPTIMIZATION (CRITICAL for Free tier)
# ============================================
NODE_ENV=production
NODE_OPTIONS=--max-old-space-size=460

# ============================================
# APPLICATION
# ============================================
PORT=3000
API_VERSION=v1

# ============================================
# DATABASE (Supabase)
# ============================================
# IMPORTANT: Use port 6543 (pooler) for production
DATABASE_URL=postgresql://postgres.[project-id]:[password]@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?schema=public&pgbouncer=true

# ============================================
# JWT (Generate with: openssl rand -hex 32)
# ============================================
JWT_ACCESS_SECRET=[click "Generate Value" in Render]
JWT_REFRESH_SECRET=[click "Generate Value" in Render]
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============================================
# OPENAI API
# ============================================
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL_WHISPER=whisper-1
OPENAI_MODEL_GPT=gpt-4o-mini-2024-07-18

# ============================================
# GEMINI API (Optional Alternative)
# ============================================
GEMINI_API_KEY=AIza...
STT_PROVIDER=whisper

# ============================================
# STORAGE (Use /tmp on Render)
# ============================================
STORAGE_TYPE=local
STORAGE_PATH=/tmp/uploads

# ============================================
# CORS (Update with your frontend domain)
# ============================================
CORS_ORIGIN=https://your-frontend.vercel.app

# ============================================
# LOGGING (Use 'info' not 'debug')
# ============================================
LOG_LEVEL=info

# ============================================
# VOICE PROCESSING
# ============================================
MAX_AUDIO_FILE_SIZE_MB=10
MAX_AUDIO_DURATION_SEC=60

# ============================================
# TELEGRAM BOT (Optional)
# ============================================
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=...
TELEGRAM_WEBHOOK_URL=https://your-app.onrender.com/telegram/webhook
